# =============================================================================
# .env.example – Vorlage für Umgebungsvariablen des Processors
# Kopieren: cp env.example .env
# Die .env Datei NIEMALS in Git einchecken (steht in .gitignore)!
# =============================================================================

# Event-Hub-kompatibler Endpunkt des IoT Hub (Azure Portal → IoT Hub →
# Built-in endpoints, oder: az iot hub show --query properties.eventHubEndpoints.events)
# Connection String mit der "service"-Policy (ServiceConnect-Recht genügt, kein iothubowner nötig):
#   az iot hub policy show --hub-name <hub> --name service --query primaryKey -o tsv
EVENTHUB_CONNECTION_STRING=Endpoint=sb://DEIN-NAMESPACE.servicebus.windows.net/;SharedAccessKeyName=service;SharedAccessKey=DEIN-KEY
EVENTHUB_NAME=DEIN-EVENTHUB-PATH
CONSUMER_GROUP=processor

# Azure SQL (siehe main.bicep / parameters/dev.bicepparam)
SQL_SERVER=sql-pipeline-dev-swn-ghxzap.database.windows.net
SQL_DATABASE=sensordata
SQL_USER=sqladmin
SQL_PASSWORD=DEIN-SQL-PASSWORT
