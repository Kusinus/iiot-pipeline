# =============================================================================
# .env.example – Vorlage für Umgebungsvariablen
# Kopieren: cp .env.example .env
# Die .env Datei NIEMALS in Git einchecken (steht in .gitignore)!
# =============================================================================

# Azure IoT Hub Device Connection String
# Zu finden in: Azure Portal → IoT Hub → Devices → dein Gerät → Primary Connection String
IOTHUB_DEVICE_CONNECTION_STRING=HostName=DEIN-HUB.azure-devices.net;DeviceId=rpi-edge-01;SharedAccessKey=DEIN-KEY

# Gerätekonfiguration
DEVICE_ID=rpi-edge-01
LOCATION=luetschental

# Wie oft Daten gesendet werden (Sekunden)
# 15s = 5'760 Nachrichten/Tag – bleibt unter dem IoT-Hub-Free-Tier-Limit
# von 8'000 Nachrichten/Tag (10s wären bereits 8'640/Tag, also drüber).
SEND_INTERVAL_SEC=15

# Hinweis: Der DHT22 hängt fest an GPIO4 (physischer Pin 7) und wird über
# den Kernel-Treiber gelesen. Voraussetzung auf dem Pi (einmalig, vor dem
# ersten Start): scripts/setup-dht-overlay.sh ausführen und neu starten.
